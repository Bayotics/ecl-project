# Copy to .env.local (local) and add the same keys in Vercel → Project → Settings → Environment Variables.
# Without MONGODB_URI the site runs on its built-in content and the member/admin areas are unavailable.

# Database (MongoDB Atlas → Connect → Drivers)
MONGODB_URI=
MONGODB_DB=ecl

# Sessions: a random string of 32+ characters (e.g. `openssl rand -base64 48`)
AUTH_SECRET=

# Account emails (Sendridge dashboard → API keys, an sr_… key; EMAIL_FROM on a verified domain)
SENDRIDGE_API_KEY=
EMAIL_FROM=

# Uploaded media (Cloudflare R2 → bucket → Settings; API token with Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Absolute site address used in email links (optional; defaults to the request's own address)
NEXT_PUBLIC_SITE_URL=
