# Canonical site origin used for metadata, sitemap, share links and checkout return URLs.
NEXT_PUBLIC_SITE_URL=https://ekoclublouisiana.org

# ── Form delivery ────────────────────────────────────────────────────────────
# Each validated submission is POSTed as JSON ({ form, submittedAt, source, ...fields }) to a webhook
# (form-to-email service, Google Apps Script/Sheets, Zapier/Make, CRM). Success is shown only on a 2xx.
# FORMS_WEBHOOK_URL is the fallback for every form; set per-form URLs to route them separately.
FORMS_WEBHOOK_URL=
CONTACT_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=
MEMBERSHIP_WEBHOOK_URL=
VOLUNTEER_WEBHOOK_URL=
RSVP_WEBHOOK_URL=
# Optional: signs each body as X-ECL-Signature: sha256=<hex HMAC-SHA256 of the raw body>.
FORMS_WEBHOOK_SECRET=

# ── Data store ───────────────────────────────────────────────────────────────
# Needed for donations (verified status), RSVP capacity/duplicate checks and shared rate limits.
# Serverless (e.g. Vercel): Upstash Redis REST credentials.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Single long-running Node server only: a writable directory outside /public.
DATA_DIR=

# ── Donations (Stripe hosted Checkout) ───────────────────────────────────────
# Use sk_test_ keys until the club approves going live. Live keys are refused unless
# DONATIONS_ALLOW_LIVE=true. Webhook endpoint: https://<site>/api/donate/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DONATIONS_ALLOW_LIVE=

# ── Analytics (optional, cookieless) ─────────────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional self-hosted script URL; defaults to https://plausible.io/js/script.js
NEXT_PUBLIC_PLAUSIBLE_SRC=
